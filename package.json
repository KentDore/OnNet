{
  "name": "onnet",
  "version": "2.2.3",
  "private": true,
  "description": "Comparateur de salaires utilisant l’API officielle Mon-entreprise / Urssaf.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:publicodes": "node scripts/build-publicodes.js",
    "test:publicodes": "node --test test/publicodes.test.js",
    "test:prototype": "npm run test:all",
    "scenarios:publicodes": "node scripts/publicodes-scenarios.mjs",
    "compare:urssaf-api": "node scripts/compare-urssaf-api.mjs",
    "diagnose:urssaf-meal-tickets": "node scripts/diagnose-urssaf-meal-tickets.mjs",
    "diagnose:overtime-50": "node scripts/diagnose-overtime-50.mjs",
    "test:urssaf-api": "node --test test/urssaf-api-client.test.mjs",
    "test:all": "npm run test:publicodes && npm run test:urssaf-api && node --test test/ui-utils.test.js test/urssaf-calculation.test.mjs test/rate-limited-fetch.test.mjs test/smic-reference.test.mjs test/urssaf-calculation-cache.test.mjs test/urssaf-session-state.test.mjs test/persistence-codec.test.mjs",
    "lint:js": "eslint --config eslint.config.mjs \"src/**/*.js\" \"src/**/*.mjs\" \"scripts/**/*.js\" \"scripts/**/*.mjs\" \"test/**/*.js\" \"test/**/*.mjs\"",
    "lint:css": "stylelint --config .stylelintrc.json \"src/styles/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css"
  },
  "dependencies": {
    "modele-social": "11.1.0",
    "publicodes": "1.10.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "playwright": "1.65.1",
    "stylelint": "18.0.0"
  }
}
